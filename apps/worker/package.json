{
	"name": "@ekra/worker",
	"version": "0.0.0",
	"private": true,
	"description": "Ekra background worker: turns uploaded videos into streams (ffmpeg), one job at a time.",
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"scripts": {
		"dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
		"start": "node --env-file-if-exists=../../.env src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --env-file-if-exists=../../.env --import ./src/test-env.ts --test 'src/**/*.test.ts'"
	},
	"dependencies": {
		"@ekra/db": "workspace:*",
		"@ekra/media": "workspace:*",
		"@ekra/storage": "workspace:*",
		"@t3-oss/env-core": "^0.13.11",
		"drizzle-orm": "1.0.0-rc.5",
		"evlog": "^2.34.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.6"
	}
}
