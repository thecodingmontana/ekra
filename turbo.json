{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".output/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": ["^build"],
			// tests talk to a real database, so always run them and let its address through
			"cache": false,
			"passThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL"]
		}
	}
}
