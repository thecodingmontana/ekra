# Copy to .env and change the passwords: cp .env.example .env
# .env is gitignored. Never commit real values.

# --- Postgres (infra/docker-compose.yml) ---
POSTGRES_USER=ekra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ekra
POSTGRES_PORT=5433
DATABASE_URL=postgres://ekra:change-me@localhost:5433/ekra
TEST_DATABASE_URL=postgres://ekra:change-me@localhost:5433/ekra_test

# --- SeaweedFS S3 (infra/docker-compose.yml) ---
S3_PORT=8334
S3_ENDPOINT=http://localhost:8334
S3_REGION=us-east-1
S3_BUCKET=ekra
S3_ACCESS_KEY=ekra
S3_SECRET_KEY=change-me

# --- API server (apps/server) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=4000

# --- Sign-in (Better Auth, in apps/server) ---
# A long random string that signs sessions: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
# The address people open the app at (the web app, which forwards /api to the server)
BETTER_AUTH_URL=http://localhost:3000
# Optional: "Continue with Google" appears only when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web app (apps/web) ---
API_URL=http://127.0.0.1:4000
