{
	"name": "ekra",
	"version": "0.0.0",
	"private": true,
	"description": "Ekra is a self-hosted, multi-tenant learning platform for companies training their teams and creators publishing courses: video courses with transcripts, quizzes, learning paths, assignments, live classes and AI help.",
	"keywords": [
		"lms",
		"learning-management-system",
		"e-learning",
		"courses",
		"quizzes",
		"learning-paths",
		"video-courses",
		"live-classes",
		"webrtc",
		"multi-tenant",
		"self-hosted",
		"tanstack-start",
		"react",
		"hono",
		"graphql",
		"drizzle",
		"postgres",
		"better-auth",
		"seaweedfs",
		"monorepo"
	],
	"homepage": "https://github.com/thecodingmontana/ekra#readme",
	"bugs": {
		"url": "https://github.com/thecodingmontana/ekra/issues",
		"email": "thecodingmontana@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thecodingmontana/ekra.git"
	},
	"license": "PolyForm-Noncommercial-1.0.0",
	"author": {
		"name": "Christopher Odhiambo",
		"email": "thecodingmontana@gmail.com",
		"url": "https://github.com/thecodingmontana"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/thecodingmontana"
	},
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=22",
		"pnpm": ">=12"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"check": "biome check --css-parse-tailwind-directives=true .",
		"check:fix": "biome check --write --css-parse-tailwind-directives=true .",
		"format": "biome format --write --css-parse-tailwind-directives=true .",
		"services:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
		"services:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
		"services:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
		"services:reset": "docker compose --env-file .env -f infra/docker-compose.yml down -v",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "^26.6.6",
		"lefthook": "^2.2.2",
		"turbo": "^2.11.10",
		"typescript": "^7.0.2"
	}
}
